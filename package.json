{
  "name": "spij-mcp",
  "version": "0.2.0",
  "description": "MCP server para buscar normas y jurisprudencia del SPIJ (Perú)",
  "type": "module",
  "private": true,
  "license": "MIT",
  "bin": {
    "spij-mcp": "src/server.js"
  },
  "files": [
    "src",
    "docs",
    "README.md"
  ],
  "scripts": {
    "start": "node src/server.js",
    "build:mcpb": "node scripts/build-mcpb.mjs",
    "test": "node test/smoke.js && node test/mcp-protocol.js && node test/updates.js && node test/export.js",
    "test:updates": "node test/updates.js",
    "smoke": "node test/smoke.js",
    "test:protocol": "node test/mcp-protocol.js"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "mcp",
    "spij",
    "peru",
    "jurisprudencia",
    "normas",
    "minjus"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "^2.1.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dariodemh/spijmcp.git"
  },
  "homepage": "https://github.com/dariodemh/spijmcp"
}
