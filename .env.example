# Cuenta de suscriptor del SPIJ (opcional).
# Sin estas variables el MCP usa el acceso libre: metadatos y sumilla,
# pero no el texto completo de las resoluciones.
SPIJ_USUARIO=
SPIJ_CLAVE=

# Repositorio GitHub "usuario/repo" usado para comprobar actualizaciones.
# Si se deja vacío o con el valor de ejemplo, la comprobación queda desactivada.
SPIJ_MCP_REPO=dariodemh/spijmcp

# "0" desactiva la comprobación automática de actualizaciones al arrancar.
SPIJ_MCP_CHECK_UPDATES=1

# Solo para el modo HTTP: token que deben enviar los clientes.
MCP_AUTH_TOKEN=

# Puerto del modo HTTP (por defecto 8787).
PORT=8787

# Peticiones por minuto y por IP en el modo HTTP (por defecto 120).
MCP_RATE_LIMIT=120
